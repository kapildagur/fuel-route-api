# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# Free key: create an account at https://account.heigit.org/signup
ORS_API_KEY=

# Local development only. In production set DJANGO_DEBUG=false and a long random
# DJANGO_SECRET_KEY, for example from:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional settings, shown with their defaults.
# ORS_PROFILE=driving-hgv
# ORS_TIMEOUT_SECONDS=10
# FUELROUTE_TANK_GALLONS=50
# FUELROUTE_MILES_PER_GALLON=10
# FUELROUTE_CORRIDOR_MILES=5
# FUELROUTE_MIN_STOP_SAVING=5
# FUELROUTE_MAP_TOLERANCE_METERS=50
# FUELROUTE_CACHE_SECONDS=3600
# FUELROUTE_RATE_LIMIT=60/minute
# DATABASE_PATH=var/fuelroute.sqlite3
