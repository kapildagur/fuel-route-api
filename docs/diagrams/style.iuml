skinparam DatabaseBackgroundColor #F3F6F9
skinparam ParticipantBackgroundColor #EAF2FB
skinparam ParticipantBorderColor #2F6FAD
skinparam SequenceLifeLineBorderColor #8A97A5
skinparam ActivityBackgroundColor #EAF2FB
skinparam ActivityBorderColor #2F6FAD
